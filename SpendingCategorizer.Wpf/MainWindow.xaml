<Window x:Class="SpendingCategorizer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpendingCategorizer.Wpf"
        mc:Ignorable="d"
        Title="Spending Categorizer" Height="450" Width="800"
        Background="#FFE6B0B0">
    <!-- Soft pastel pink background -->

    <Grid>
        <StackPanel Orientation="Vertical" Margin="10">

            <!-- Button Panel -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <!--<Button Content="Open and Categorize CSV" 
                        Command="{Binding OpenCsvCommand}" 
                        Margin="5" Width="200"
                        Background="#FFD48B9B" Foreground="White" FontWeight="Bold"
                        BorderBrush="#FFB0657C" BorderThickness="2"/>-->
                <Button Content="Chase-Add and Categorize"
                        x:Name="ImportChaseButton"
                        Command="{Binding OpenChaseCsvCommand}"
                        Margin="5" Width="200"
                        Background="#FFD48B9B" Foreground="White" FontWeight="Bold"
                        BorderBrush="#FFB0657C" BorderThickness="2"
                        />
                <Button Content="CCU-Add and Categorize"
                        x:Name="ImportCCUButton"
                        Command="{Binding OpenCCUCommand}"
                        Margin="5" Width="200"
                        Background="#FFD48B9B" Foreground="White" FontWeight="Bold"
                        BorderBrush="#FFB0657C" BorderThickness="2"
                        />
                <Button Content="Clear"
                        x:Name="ClearButton"
                        Command="{Binding ClearCommand}"
                        Margin="5" Width="200"
                        Background="#FFD48B9B" Foreground="White" FontWeight="Bold"
                        BorderBrush="#FFB0657C" BorderThickness="2"
                        />
                <Button Content="Manage Categories" 
                        Command="{Binding OpenManageCategoriesWindowCommand}"
                                                Margin="5" Width="200"
                        Background="#FFD48B9B" Foreground="White" FontWeight="Bold"
                        BorderBrush="#FFB0657C" BorderThickness="2"
                        />
                <!--<Button Content="Remove CC Payments"
                        Command="{Binding OpenRemoveSuspectedCCPayments}" 
                        Margin="5" Width="200"
                        Background="#FFD48B9B" 
                        Foreground="White" 
                        FontWeight="Bold"
                        BorderBrush="#FFB0657C"
                        BorderThickness="2"
                        />-->


                <Button Content="Save CSV" 
                        Command="{Binding SaveCsvCommand}" 
                        Margin="5" Width="100"
                        Background="#FFD48B9B" Foreground="White" FontWeight="Bold"
                        BorderBrush="#FFB0657C" BorderThickness="2"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Transactions}" 
          AutoGenerateColumns="False"
          Margin="5" 
          IsReadOnly="False"
          MaxColumnWidth="250"
          CanUserSortColumns="True"  
          CanUserReorderColumns="True"
          CanUserResizeColumns="True"
          IsSynchronizedWithCurrentItem="True"
          SelectionMode="Extended"
          ScrollViewer.CanContentScroll="True"
          ScrollViewer.VerticalScrollBarVisibility="Visible"
          ScrollViewer.HorizontalScrollBarVisibility="Visible"
          EnableRowVirtualization="True"
          EnableColumnVirtualization="True"
          AlternatingRowBackground="#FFF5C6D6" 
          RowBackground="White"
          GridLinesVisibility="None"
          BorderBrush="#FFB0657C" BorderThickness="1"
          Foreground="#FF572D4A"
          FontSize="14"
          MaxHeight="700">

                <DataGrid.Columns>
                    <!-- Freezing the TransactionDate column -->
                    <DataGridTextColumn Header="Transaction Date" 
                            Binding="{Binding TransactionDate}" 
                            SortDirection="Ascending"
                            CanUserSort="True"
                            CanUserResize="True"
                            Width="Auto"
                            IsReadOnly="True"/>
                    <!-- Keeps the first column frozen -->

                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" />
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" />
                    <DataGridTextColumn Header="Amount" Binding="{Binding Ammount}" />

                    <!-- Category Column as a ComboBox -->
                    <DataGridTemplateColumn Header="Category">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Category}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=Window}}"
                              Text="{Binding Category, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                              IsEditable="True"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTemplateColumn Header="Add To Category">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Add to Category" 
                                        Click="AddToCategoryButton_Click"
                                        
                                        />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>


                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

    </Grid>
</Window>
