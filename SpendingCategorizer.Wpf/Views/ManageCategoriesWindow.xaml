<Window x:Class="SpendingCategorizer.Wpf.Views.ManageCategoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpendingCategorizer.Wpf.Views"
        mc:Ignorable="d"
        Title="ManageCategoriesWindow" Height="450" Width="800"
                Background="#FFE6B0B0">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Category Name:" Grid.Row="0"/>
        <TextBox x:Name="CategoryTextBox" Grid.Row="1"/>

        <TextBlock Text="Keyword to Add:" Grid.Row="2"/>
        <TextBox x:Name="KeywordTextBox" Grid.Row="3"/>

        <StackPanel Orientation="Horizontal" Grid.Row="4" HorizontalAlignment="Center" Margin="10">
            <Button Content="Add Category" Click="AddCategory_Click"  
                    Background="#FFD48B9B" 
                    Foreground="White" 
                    FontWeight="Bold"
                    BorderBrush="#FFB0657C" 
                    BorderThickness="2"
                    Width="120"
                    Margin="5"/>
            <Button Content="Add Keyword" Click="AddKeyword_Click"  
                    Background="#FFD48B9B" 
                    Foreground="White" 
                    FontWeight="Bold"
                    BorderBrush="#FFB0657C" 
                    BorderThickness="2"
                    Margin="5"
                    Width="120"/>
        </StackPanel>
    </Grid>
</Window>